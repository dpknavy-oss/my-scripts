#!/bin/bash

# Color definitions for clean UI
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Ensure yay is installed
if ! command -v yay &> /dev/null; then
    echo -e "${RED}[!] Error: 'yay' is not installed. Please install an AUR helper first.${NC}"
    exit 1
fi

# Step 0: Startup full system and AUR database update
echo -e "${GREEN}[+] Running startup system upgrade and package database sync (yay -Syu)...${NC}"
yay -Syu

if [ $? -ne 0 ]; then
    echo -e "${RED}[!] Warning: System update encountered an issue, but continuing to search utility...${NC}"
fi

# Main search loop
while true; do
    echo -e ""
    echo -ne "${YELLOW}[?] Enter the name of the app to search (or type 'exit' to quit): ${NC}"
    read -r app_name

    # Check for exit condition
    if [[ "$app_name" == "exit" || -z "$app_name" ]]; then
        if [ -z "$app_name" ]; then
            echo -e "${RED}[!] Error: No application name provided.${NC}"
        else
            echo -e "${GREEN}[+] Exiting. Happy Arch-ing!${NC}"
        fi
        break
    fi

    # Check if package is already installed locally
    if pacman -Q "$app_name" &> /dev/null; then
        echo -e "${GREEN}[✓] Status: '$app_name' is currently INSTALLED on your system.${NC}"
    else
        echo -e "${BLUE}[ℹ] Status: '$app_name' is NOT currently installed.${NC}"
    fi

    echo -e "\nChoose an action for '${BLUE}$app_name${NC}':"
    echo "  1) Search / Interactive Install (default)"
    echo "  2) View Package Details (-Si)"
    echo "  3) Remove Package (-Rns)"
    echo -ne "${YELLOW}[?] Select option [1-3]: ${NC}"
    read -r choice

    echo -e ""
    case "$choice" in
        2)
            echo -e "${GREEN}[+] Fetching package details...${NC}"
            yay -Si "$app_name"
            ;;
        3)
            echo -e "${RED}[+] Removing package...${NC}"
            sudo pacman -Rns "$app_name"
            ;;
        *)
            echo -e "${GREEN}[+] Searching databases and AUR...${NC}"
            yay "$app_name"
            ;;
    esac
    
    echo -e "${YELLOW}----------------------------------------${NC}"
done
